NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
COLLEGE_TIMEZONE=Asia/Kolkata

# Optional browser-visible API origin. Leave empty for same-origin production
# and local development through the Vite proxy.
VITE_API_BASE_URL=

# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-a-random-verification-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TIMETABLE_TEMPLATE=
WHATSAPP_TIMETABLE_UPDATE_TEMPLATE=
WHATSAPP_ASSIGNMENT_TEMPLATE=
WHATSAPP_EXAM_TEMPLATE=
WHATSAPP_EVENT_TEMPLATE=
WHATSAPP_NOTIFICATION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Generate VAPID keys once with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# Admin authentication
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=change-me-now

# Set false on additional Render instances so only one runs scheduled jobs
SCHEDULER_ENABLED=true
